CREATE VERTEX Chunk (PRIMARY_ID id STRING, text STRING, doc_id STRING, title STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX Entity (PRIMARY_ID id STRING, name STRING, etype STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX Event (PRIMARY_ID id STRING, title STRING, competitors INT, nations INT, date STRING, venue STRING, gold STRING, silver STRING, bronze STRING) WITH primary_id_as_attribute="true"
CREATE DIRECTED EDGE HAS_CHUNK (FROM Event, TO Chunk) WITH REVERSE_EDGE="HAS_CHUNK_REV"
CREATE DIRECTED EDGE MENTIONS (FROM Chunk, TO Entity) WITH REVERSE_EDGE="MENTIONS_REV"
CREATE DIRECTED EDGE INVOLVES (FROM Event, TO Entity, role STRING) WITH REVERSE_EDGE="INVOLVES_REV"
CREATE GRAPH {{GRAPH}} (*)
