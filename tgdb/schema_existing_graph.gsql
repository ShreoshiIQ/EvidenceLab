USE GRAPH {{GRAPH}}

CREATE SCHEMA_CHANGE JOB bench_add_types FOR GRAPH {{GRAPH}} {
  ADD VERTEX Chunk (PRIMARY_ID id STRING, text STRING, doc_id STRING, title STRING) WITH primary_id_as_attribute="true";
  ADD VERTEX Entity (PRIMARY_ID id STRING, name STRING, etype STRING) WITH primary_id_as_attribute="true";
  ADD VERTEX Event (PRIMARY_ID id STRING, title STRING, competitors INT, nations INT, date STRING, venue STRING, gold STRING, silver STRING, bronze STRING) WITH primary_id_as_attribute="true";
  ADD DIRECTED EDGE HAS_CHUNK (FROM Event, TO Chunk) WITH REVERSE_EDGE="HAS_CHUNK_REV";
  ADD DIRECTED EDGE MENTIONS (FROM Chunk, TO Entity) WITH REVERSE_EDGE="MENTIONS_REV";
  ADD DIRECTED EDGE INVOLVES (FROM Event, TO Entity, role STRING) WITH REVERSE_EDGE="INVOLVES_REV";
}
RUN SCHEMA_CHANGE JOB bench_add_types

CREATE SCHEMA_CHANGE JOB bench_add_vectors FOR GRAPH {{GRAPH}} {
  ALTER VERTEX Chunk ADD VECTOR ATTRIBUTE emb(DIMENSION={{DIM}}, METRIC="COSINE");
  ALTER VERTEX Entity ADD VECTOR ATTRIBUTE emb(DIMENSION={{DIM}}, METRIC="COSINE");
}
RUN SCHEMA_CHANGE JOB bench_add_vectors
